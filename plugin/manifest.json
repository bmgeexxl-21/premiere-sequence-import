{
  "manifestVersion": 5,
  "id": "de.guido.sequenceimport",
  "name": "Bildsequenz-Import",
  "version": "1.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "sequenceImportPanel",
      "label": { "default": "Bildsequenz-Import" },
      "minimumSize": { "width": 280, "height": 360 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 520 },
      "preferredFloatingSize": { "width": 420, "height": 600 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.svg", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    {
      "width": 48, "height": 48, "path": "icons/plugin.svg", "scale": [1, 2],
      "theme": ["all"], "species": ["pluginList"]
    }
  ]
}
